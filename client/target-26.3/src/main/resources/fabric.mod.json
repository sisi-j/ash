{
  "schemaVersion": 1,
  "id": "ash",
  "version": "${version}",
  "name": "ash",
  "description": "ash's in-game client. Presentation only: nothing it does changes what the server sees.",
  "contact": {
    "homepage": "https://github.com/sisi-j/ash",
    "sources": "https://github.com/sisi-j/ash"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ashlauncher.client.v26_3.AshClient"
    ]
  },
  "mixins": [
    "ash.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
