{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ash",
  "version": "0.1.0",
  "identifier": "com.ashlauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ash",
        "width": 1000,
        "height": 660,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0B0B0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://textures.minecraft.net https://cdn.ashlauncher.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
