# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# --- Rust / Tauri ---
target/
**/src-tauri/target/
**/src-tauri/gen/

# --- Java / Gradle (client) ---
.gradle/
build/
out/
*.class
# Eclipse and the VS Code Java extension compile into `bin/` beside the
# Gradle output. The `*.class` rule hides most of it and left the processed
# resources behind, which is how a `fabric.mod.json` nearly got committed
# twice over.
bin/

# --- Secrets & local config ---
.env
.env.*
!.env.example
.claude/settings.local.json

# --- Game data fetched at runtime, never committed ---
/instances/
/runtimes/
/game-assets/

# --- Logs ---
*.log
npm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
